{
    "name": "tyhpdef/phpdocumentor-reflection-common-impl",
    "description": "Implementation package for tyhpdef/phpdocumentor-reflection-common. Require tyhpdef/phpdocumentor-reflection-common, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.2.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/phpdocumentor-reflection-common"
        }
    },
    "require": {
        "php": ">=8.2",
        "phpdocumentor/reflection-common": "^2.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev"
    }
}
